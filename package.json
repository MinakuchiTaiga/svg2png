{
  "name": "svg2png",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check src e2e index.html vite.config.ts vitest.config.ts playwright.config.ts package.json tsconfig.json biome.json AGENTS.md README.md",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.57.0",
    "@types/node": "22.13.10",
    "@vitest/coverage-v8": "3.0.5",
    "typescript": "5.7.3",
    "vite": "6.4.1",
    "vitest": "3.0.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "9.0.7"
    }
  },
  "packageManager": "pnpm@10.4.1"
}
