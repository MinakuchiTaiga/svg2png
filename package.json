{
  "name": "svg2png",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check src index.html vite.config.ts vitest.config.ts package.json tsconfig.json biome.json AGENTS.md README.md",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.13.10",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.5",
    "@vitest/coverage-v8": "3.0.5"
  },
  "packageManager": "pnpm@10.4.1"
}
